{
  "mcpServers": {
    "allure-testops": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/vendor/allure-testops-mcp.mjs"],
      "env": {
        "ALLURE_TESTOPS_URL": "${ALLURE_ENDPOINT:-https://astbroker.qatools.cloud}",
        "ALLURE_TOKEN": "${user_config.allure_token}",
        "ALLURE_PROJECT_ID": "35"
      }
    },
    "redmine": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "mcp-redmine==2026.1.13.152335", "mcp-redmine"],
      "env": {
        "REDMINE_URL": "${REDMINE_URL:-https://redmine.fast-system.ru}",
        "REDMINE_API_KEY": "${user_config.redmine_api_key}"
      }
    },
    "kaiten": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/pyuscherbakov/kaiten-mcp@6961c7c", "kaiten-mcp"],
      "env": {
        "KAITEN_BASE_URL": "${KAITEN_BASE_URL:-https://lab-company.kaiten.ru}",
        "KAITEN_TOKEN": "${user_config.kaiten_api_token}",
        "KAITEN_MCP_MODULES": "cards,comments,documents,tree,spaces,boards,columns"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${user_config.context7_api_key}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
