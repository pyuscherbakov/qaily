{
  "mcpServers": {
    "testops": {
      "type": "http",
      "url": "https://astbroker.qatools.cloud/api/mcp",
      "headers": {
        "Authorization": "Api-Token ${user_config.allure_token}"
      }
    },
    "redmine": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "mcp-redmine==2026.09.10.084818", "mcp-redmine"],
      "env": {
        "REDMINE_URL": "https://redmine.fast-system.ru",
        "REDMINE_API_KEY": "${user_config.redmine_api_key}",
        "REDMINE_ALLOWED_DIRECTORIES": "/tmp/qaily-redmine",
        "REDMINE_READ_ONLY": "1"
      }
    },
    "kaiten": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "git+https://github.com/pyuscherbakov/kaiten-mcp@8d3c666", "kaiten-mcp"],
      "env": {
        "KAITEN_BASE_URL": "https://lab-company.kaiten.ru",
        "KAITEN_TOKEN": "${user_config.kaiten_api_token}",
        "KAITEN_MCP_MODULES": "cards,comments,documents,tree,spaces,boards,columns"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"],
      "env": {
        "CONTEXT7_API_KEY": "${user_config.context7_api_key}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.81"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.9.0"]
    },
    "jam": {
      "type": "http",
      "url": "https://mcp.jam.dev/mcp"
    }
  }
}
