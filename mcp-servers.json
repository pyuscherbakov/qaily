{
  "mcpServers": {
    "testops": {
      "type": "http",
      "url": "https://astbroker.qatools.cloud/api/mcp",
      "headersHelper": "uv run -q --script \"${CLAUDE_PLUGIN_ROOT}/bin/qaily_launch.py\" headers \"Authorization=Api-Token {allure}\""
    },
    "redmine": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/bin/qaily_launch.py", "run",
        "--secret", "REDMINE_API_KEY=redmine",
        "--dir", "REDMINE_ALLOWED_DIRECTORIES=~/.qaily/redmine",
        "--", "uvx", "--from", "mcp-redmine==2026.09.10.084818", "mcp-redmine"
      ],
      "env": {
        "REDMINE_URL": "https://redmine.fast-system.ru",
        "REDMINE_READ_ONLY": "1"
      }
    },
    "kaiten": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/bin/qaily_launch.py", "run",
        "--secret", "KAITEN_TOKEN=kaiten",
        "--", "uvx", "--from", "git+https://github.com/pyuscherbakov/kaiten-mcp@8d3c666", "kaiten-mcp"
      ],
      "env": {
        "KAITEN_BASE_URL": "https://lab-company.kaiten.ru",
        "KAITEN_MCP_MODULES": "cards,comments,documents,tree,spaces,boards,columns"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/bin/qaily_launch.py", "run",
        "--secret", "CONTEXT7_API_KEY=context7?",
        "--", "npx", "-y", "@upstash/context7-mcp@4.1.1"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/bin/qaily_launch.py", "run",
        "--", "npx", "-y", "@playwright/mcp@0.0.81"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/bin/qaily_launch.py", "run",
        "--", "npx", "-y", "chrome-devtools-mcp@1.9.0"
      ]
    },
    "jam": {
      "type": "http",
      "url": "https://mcp.jam.dev/mcp"
    }
  }
}
