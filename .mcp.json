{
  "mcpServers": {
    "testops": {
      "type": "http",
      "url": "https://astbroker.qatools.cloud/api/mcp",
      "enabled": true,
      "default_tools_approval_mode": "prompt"
    },
    "redmine": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-q",
        "--script",
        "./bin/qaily_launch.py",
        "run",
        "--service", "redmine",
        "--secret",
        "REDMINE_API_KEY=redmine",
        "--dir",
        "REDMINE_ALLOWED_DIRECTORIES=~/.qaily/redmine",
        "--",
        "uvx",
        "--from",
        "mcp-redmine==2026.09.10.084818",
        "mcp-redmine"
      ],
      "env": {
        "REDMINE_URL": "https://redmine.fast-system.ru",
        "REDMINE_READ_ONLY": "1"
      },
      "cwd": "."
    },
    "kaiten": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-q",
        "--script",
        "./bin/qaily_launch.py",
        "run",
        "--service", "kaiten",
        "--secret",
        "KAITEN_TOKEN=kaiten",
        "--",
        "uvx",
        "--from",
        "git+https://github.com/pyuscherbakov/kaiten-mcp@8d3c666",
        "kaiten-mcp"
      ],
      "env": {
        "KAITEN_BASE_URL": "https://lab-company.kaiten.ru",
        "KAITEN_MCP_MODULES": "cards,comments,documents,tree,spaces,boards,columns"
      },
      "enabled_tools": ["kaiten_get_card", "kaiten_get_document", "kaiten_list_comments", "kaiten_list_documents"],
      "cwd": "."
    },
    "context7": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-q",
        "--script",
        "./bin/qaily_launch.py",
        "run",
        "--secret",
        "CONTEXT7_API_KEY=context7?",
        "--",
        "npx",
        "-y",
        "@upstash/context7-mcp@4.1.1"
      ],
      "enabled_tools": ["query-docs", "resolve-library-id"],
      "cwd": "."
    },
    "playwright": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-q",
        "--script",
        "./bin/qaily_launch.py",
        "run",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@0.0.81"
      ],
      "cwd": "."
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-q",
        "--script",
        "./bin/qaily_launch.py",
        "run",
        "--",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.9.0"
      ],
      "cwd": "."
    },
    "jam": {
      "type": "http",
      "url": "https://mcp.jam.dev/mcp",
      "enabled_tools": []
    }
  }
}
